---
import type { TimelineItem } from '../lib/data';
interface Props { items: TimelineItem[] }
const { items } = Astro.props;
---
<ol class="timeline">
  {items.map((it) => (
    <li>
      <span class="period">{it.period}</span>
      <div>
        <div class="row-title">{it.role}</div>
        <div class="row-meta">{it.org}{it.note ? ` · ${it.note}` : ''}</div>
      </div>
      {it.logo ? <img src={it.logo} alt="" width="40" height="40" class="logo" loading="lazy" /> : <span />}
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li {
    display: grid; grid-template-columns: 120px minmax(0, 1fr) 40px; gap: 16px; align-items: center;
    padding: 14px 0; border-bottom: 1px solid var(--line);
  }
  .timeline li:last-child { border-bottom: 0; }
  .period { font-size: var(--fs-small); font-weight: 700; color: var(--accent); }
  .logo { width: 40px; height: 40px; object-fit: contain; background: #FFFFFF; border-radius: 8px; padding: 4px; }
  @media (max-width: 560px) {
    .timeline li { grid-template-columns: minmax(0, 1fr) 40px; gap: 4px 12px; }
    .period { grid-column: 1 / -1; }
  }
</style>
