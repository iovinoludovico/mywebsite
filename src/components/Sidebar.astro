---
import { profile } from '../lib/data';
import Email from './Email.astro';

const nav = [
  { href: '/', label: 'About' },
  { href: '/publications/', label: 'Publications' },
  { href: '/research/', label: 'Research' },
  { href: '/teaching/', label: 'Teaching' },
  { href: '/service/', label: 'Service' },
  { href: '/cv/', label: 'CV' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/research/' && path.startsWith('/projects/'));
const shortLinks = profile.links.filter((l) => ['Google Scholar', 'ORCID', 'GitHub', 'LinkedIn'].includes(l.label));
---
<aside class="sidebar">
  <a href="/" class="identity">
    <img src={profile.photo} alt="" width="132" height="132" class="photo" />
    <span>
      <span class="name">{profile.name}</span>
      <span class="role">{profile.title}<br />{profile.affiliation}</span>
    </span>
  </a>

  <nav aria-label="Main">
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="contact">
    <Email class="email" />
    <span class="addr">{profile.contact.address}</span>
    <div class="links">
      {shortLinks.map((l) => <a href={l.url} rel="me noopener">{l.label === 'Google Scholar' ? 'Scholar' : l.label}</a>)}
    </div>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <span>Theme</span>
    </button>
  </div>
</aside>

<style>
  .sidebar {
    flex: 1 1 300px; max-width: 340px;
    position: sticky; top: 32px;
    background: var(--side-bg); color: var(--side-text);
    padding: 32px; border-radius: var(--radius-lg);
  }
  .identity { display: block; text-decoration: none; color: inherit; }
  .photo { display: block; width: 132px; height: 132px; object-fit: cover; border-radius: 50%; border: 3px solid var(--accent-on-dark); }
  .name { display: block; margin: 20px 0 4px; font-size: 28px; line-height: 1.2; font-weight: 800; color: var(--side-ink); }
  .role { display: block; color: var(--side-muted); font-size: 15px; }

  nav ul { list-style: none; margin: 20px 0 24px; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  nav a {
    display: block; padding: 10px 14px; border-radius: var(--radius-sm);
    color: var(--side-text); text-decoration: none; font-weight: 500;
  }
  nav a:hover { background: var(--side-active); color: var(--side-ink); }
  nav a[aria-current='page'] { background: var(--side-active); color: var(--side-ink); font-weight: 700; }

  .contact { border-top: 1px solid var(--side-line); padding-top: 20px; font-size: 14px; display: flex; flex-direction: column; gap: 8px; }
  .contact :global(.email) { color: var(--side-ink); }
  .addr { color: var(--side-muted); }
  .links { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 8px; }
  .links a { color: var(--side-ink); }
  .links a:hover, .contact :global(.email:hover) { color: var(--accent-on-dark); }

  .theme-toggle {
    align-self: flex-start; margin-top: 12px; display: inline-flex; align-items: center; gap: 8px;
    min-height: 36px; padding: 0 12px; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--side-text); border: 1px solid var(--side-line); font: inherit; font-size: 13px;
  }
  .theme-toggle:hover { color: var(--side-ink); border-color: var(--side-muted); }

  /* Phone/tablet: compact header card instead of a tall sidebar. */
  @media (max-width: 900px) {
    .sidebar { position: static; max-width: none; flex-basis: 100%; padding: 20px; }
    .identity { display: flex; align-items: center; gap: 16px; }
    .photo { width: 72px; height: 72px; }
    .name { margin: 0 0 2px; font-size: 22px; }
    .role { font-size: 14px; }
    nav ul { flex-direction: row; flex-wrap: wrap; margin: 16px 0 0; gap: 4px; }
    nav a { padding: 8px 12px; min-height: 40px; }
    .contact { display: none; }
  }
</style>
