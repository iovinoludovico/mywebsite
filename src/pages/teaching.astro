---
import Base from '../layouts/Base.astro';
import { teaching } from '../lib/data';
---
<Base title="Teaching" description="Courses, PhD supervision and available thesis topics.">
  <section class="card">
    <h1 class="page-title">Teaching</h1>
    <p class="lead">Courses at the GSSI PhD school and the University of L'Aquila, PhD supervision and open thesis topics.</p>
  </section>

  <section class="card">
    <h2>Courses</h2>
    <ul class="rows">
      {teaching.courses.map((c) => (
        <li class="split">
          <div><div class="row-title">{c.title}</div><div class="row-meta">{c.kind} · {c.role}, {c.org}</div></div>
          <span class="period">{c.period}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="card">
    <h2>PhD supervision</h2>
    <ul class="rows">
      {teaching.supervision.map((s) => (
        <li class="split">
          <div><div class="row-title">{s.name}</div><div class="row-meta">{s.topic}{s.note ? ` · ${s.note}` : ''}</div></div>
          <span class="period">{s.period}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="card" id="theses">
    <h2>Available theses</h2>
    {teaching.theses.map((t) => (
      <article class="thesis">
        <h3>{t.title}</h3>
        <p class="muted">{t.text}</p>
        {t.references && (
          <ol class="small subtle refs">
            {t.references.map((r) => <li>{r.url ? <a href={r.url}>{r.text}</a> : r.text}</li>)}
          </ol>
        )}
      </article>
    ))}
    <p class="small">Interested? <a href="/contact/">Get in touch</a>.</p>
  </section>
</Base>

<style>
  .split { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .period { flex: none; font-size: var(--fs-small); font-weight: 700; color: var(--accent); }
  .thesis { margin-bottom: 16px; }
  .refs { padding-left: 20px; }
  @media (max-width: 560px) { .split { flex-direction: column-reverse; gap: 2px; } }
</style>
